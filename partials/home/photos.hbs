{{#get "posts" filter="tag:[gallery,photography]+tag:-hash-bluesky+feature_image:-null" limit="10" as |photo_posts|}}
    {{#if photo_posts}}
    <section class="cactus-section home-section home-photos-section">
        <h2 class="cactus-title"><a href="{{@site.url}}/gallery/">{{t "Latest Photos"}}</a></h2>
        <ul class="home-photos" role="list">
            {{#foreach photo_posts}}
            <li>
                <a href="{{url}}" aria-label="{{title}}">
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 1140w"
                        sizes="(min-width: 600px) 480px, 85vw"
                        src="{{img_url feature_image size="s"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        loading="lazy"
                    >
                </a>
            </li>
            {{/foreach}}
        </ul>
    </section>
    {{/if}}
{{/get}}
