<header class="archive-header">
    <h1 class="cactus-title"><a href="{{@site.url}}/field-notes/">Field Notes</a></h1>
    {{> "section-description" slug="field-notes"}}
</header>

<section class="cactus-section archive-section">
    {{#get "posts" filter="primary_tag:field-notes" limit="7" include="tags" order="published_at desc" as |field_notes field_notes_pages|}}
    <ul class="post-list" role="list">
        {{#foreach field_notes}}
            {{> "post-preview"}}
        {{else}}
            <li>No field notes are published yet.</li>
        {{/foreach}}
    </ul>
    {{#if field_notes_pages.next}}<p class="home-more"><a href="{{@site.url}}/field-notes/">{{t "More field notes"}} &rarr;</a></p>{{/if}}
    {{/get}}
</section>
