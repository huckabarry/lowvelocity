{{!-- Newsletter sign-up box. Used at the end of posts and as the "subscribe" homepage section.
     Only the urbanism essays are emailed; field notes and photos stay on the site, and the copy says so.
     A #/portal/ link (not an inline form) so it keeps working after the theme's in-place page loads.
     Hidden for signed-in members and invite-only sites. --}}
{{#if @site.members_enabled}}{{#unless @member}}{{#unless @site.members_invite_only}}
<aside class="lv-subscribe-box" aria-label="{{t "Newsletter"}}">
    {{#if title}}<p class="lv-subscribe-box__title">{{title}}</p>{{/if}}
    <p class="lv-subscribe-box__text">{{text}}</p>
    <a class="lv-subscribe-button" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
</aside>
{{/unless}}{{/unless}}{{/if}}
