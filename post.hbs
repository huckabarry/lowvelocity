{{!< default}}

{{#post}}
{{#has tag="check-ins"}}
    <link rel="stylesheet" href="{{asset "vendor/leaflet/leaflet.css"}}">
    <script src="{{asset "vendor/leaflet/leaflet.js"}}"></script>
{{/has}}

<article class="{{post_class}} cactus-article{{#match @custom.post_style "~^" "Clean"}} is-clean{{/match}}{{#match @custom.post_style "Clean, body font"}} is-body-font{{/match}}">
    <header class="cactus-article-header">
        {{#has tag="#crucialtracks"}}
            <h1 class="is-visually-hidden">{{title}}</h1>
        {{else has tag="afterword,#bluesky"}}
        {{else}}
            <h1 class="cactus-title cactus-article-title">{{title}}</h1>
        {{/has}}

        {{#match @custom.post_style "~^" "Clean"}}
        {{!-- Clean: date and author as quiet pills (Design → Theme → Post → Post style). --}}
        <div class="cactus-meta post-pills">
            <time class="post-pill" datetime="{{date format="YYYY-MM-DD"}}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>
                {{date published_at format="MMM D, YYYY"}}
            </time>
            {{#primary_author}}
                <span aria-hidden="true">·</span>
                <a class="post-pill" href="{{url}}" rel="author">@{{#split name separator=" " as |name_parts|}}{{#foreach name_parts limit="1" as |first_name|}}{{first_name}}{{/foreach}}{{/split}}</a>
            {{/primary_author}}
        </div>
        {{else}}
        <div class="cactus-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date published_at format="DD MMM YYYY"}}</time>
            {{#has tag="#crucialtracks"}}
            {{else}}
                <span aria-hidden="true">/</span>
                <span>{{reading_time}}</span>
            {{/has}}
            {{#if primary_tag}}
                <span aria-hidden="true">/</span>
                {{#has tag="#crucialtracks"}}
                    {{#primary_tag}}<a href="{{@site.url}}/listening/">{{name}}</a>{{/primary_tag}}
                {{else}}
                    {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}
                {{/has}}
            {{/if}}
        </div>
        {{/match}}

        {{#has tag="#crucialtracks"}}
        {{else}}
            {{#if custom_excerpt}}
                <p class="cactus-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        {{/has}}

        {{#has tag="#crucialtracks"}}
        {{else}}
            {{> "feature-image"}}
        {{/has}}
    </header>

    {{#has tag="#crucialtracks"}}
        <div class="cactus-content lv-listening-post" data-listening-preview>
            {{#if feature_image}}
                <figure class="lv-listening-entry__art lv-listening-post__art">
                    <button class="lv-listening-post__play" type="button" aria-label="{{t "Play preview"}}: {{title}}" data-listening-preview-toggle>
                        <img
                            srcset="{{img_url feature_image size="s"}} 300w,
                                    {{img_url feature_image size="m"}} 750w"
                            sizes="(min-width: 760px) 650px, calc(100vw - 2rem)"
                            src="{{img_url feature_image size="m"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                        <span class="listening-ticker-icon" aria-hidden="true"></span>
                    </button>
                </figure>
            {{/if}}
            <div class="lv-listening-post__body">
                {{content}}
            </div>
        </div>
    {{else}}
        <div class="cactus-content">
            {{content}}
            {{#has tag="check-ins"}}
                <figure class="checkin-post-map-card">
                    <div class="checkins-map checkin-post-map" data-checkin-post-map aria-label="{{t "Map of this check-in"}}"></div>
                </figure>
            {{/has}}
        </div>
    {{/has}}

    {{!-- Ghost → Settings → Design → Theme → Post → Discussion --}}
    {{#match @custom.discussion "!=" "Ghost comments only"}}
    {{#has tag="#bluesky"}}
        <section
            class="atproto-engagement"
            data-atproto-engagement
            data-atproto-endpoint="https://sync.lowvelocity.org/updates/bluesky/thread"
            data-atproto-rkey="{{slug}}"
            aria-label="{{t "Bluesky discussion"}}">
            <p class="atproto-engagement__status">{{t "Loading Bluesky discussion…"}}</p>
        </section>
    {{else}}
        {{!-- Shown only when the sync Worker has added a lowvelocity:bluesky-post meta tag (an announced post). --}}
        <section
            class="atproto-engagement"
            data-atproto-engagement
            data-atproto-from-meta
            data-atproto-endpoint="https://sync.lowvelocity.org/updates/bluesky/thread"
            aria-label="{{t "Bluesky discussion"}}"
            hidden>
            <p class="atproto-engagement__status">{{t "Loading Bluesky discussion…"}}</p>
        </section>
    {{/has}}
    {{/match}}

    {{#if tags}}
        <footer class="post-tags">
            {{#foreach tags}}
                <a href="{{url}}">#{{name}}</a>
            {{/foreach}}
        </footer>
    {{/if}}

    {{!-- Author card from the author's Ghost profile (Settings → Staff): photo, name, location, bio,
         website, and every social account via Ghost's {{#social_accounts}} helper with icons in partials/icons/. --}}
    {{#primary_author}}
    <aside class="author-card" aria-label="{{t "About the author"}}">
        <div class="author-card__head">
            {{#if profile_image}}
                <a class="author-card__avatar" href="{{url}}" tabindex="-1" aria-hidden="true"><img src="{{img_url profile_image size="s"}}" alt="" width="72" height="72" loading="lazy"></a>
            {{/if}}
            <div>
                <p class="author-card__eyebrow">{{t "Written by"}}</p>
                <p class="author-card__name"><a href="{{url}}">{{name}}</a></p>
                {{#if location}}<p class="author-card__location">{{> "icons/location"}}{{location}}</p>{{/if}}
            </div>
        </div>
        <div class="author-card__text">
            {{#if bio}}<p class="author-card__bio">{{bio}}</p>{{/if}}
            <div class="author-card__social">
                {{#if website}}<a class="author-card__icon" href="{{website}}" rel="me noopener" aria-label="{{t "Website"}}" title="{{t "Website"}}">{{> "icons/social-website"}}</a>{{/if}}
                {{#social_accounts this}}
                    <a class="author-card__icon" href="{{href}}" target="_blank" rel="me noopener" aria-label="{{name}}" title="{{name}}">{{#> (concat "icons/social-" type)}}<span class="author-card__icon-text">{{name}}</span>{{/undefined}}</a>
                {{/social_accounts}}
            </div>
        </div>
    </aside>
    {{/primary_author}}
</article>

{{#if comments}}
{{#match @custom.discussion "!=" "Bluesky replies only"}}
    <section class="cactus-comments">
        {{#match @custom.color_scheme "Dark"}}
            {{comments mode="dark"}}
        {{else match @custom.color_scheme "Light"}}
            {{comments mode="light"}}
        {{else}}
            {{comments mode="auto"}}
        {{/match}}
        <script>
            (() => {
                const script = document.currentScript.previousElementSibling;
                if (!script || !script.matches("script[data-ghost-comments]")) return;
                const theme = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
                script.setAttribute("data-color-scheme", theme);
            })();
        </script>
    </section>
{{/match}}
{{/if}}

{{/post}}

{{!-- Outside {{#post}} (as in Dawn) so the related-posts query can read post.tags and post.id. --}}
{{#if @custom.show_related_posts}}
    {{> "related-posts"}}
{{/if}}

<style>
    /* Post style: Clean (Design → Theme → Post). Simple sans text, pill date and author. */
    .post-pills { align-items: center; gap: 0.45rem; }
    .post-pill { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.2rem 0.6rem; border-radius: 0.5rem; background: color-mix(in srgb, var(--color-global-text) 9%, transparent); color: var(--color-global-text); font-family: var(--font-heading); font-style: normal; font-size: 0.9rem; line-height: 1.4; text-decoration: none; }
    a.post-pill:hover { background: color-mix(in srgb, var(--color-global-text) 15%, transparent); color: var(--color-global-text); }
    .post-pill svg { opacity: 0.75; }
    /* "Clean" sets post text in the heading font; "Clean, body font" keeps the Body font settings. */
    .is-clean:not(.is-body-font) .cactus-excerpt,
    .is-clean:not(.is-body-font) .cactus-content,
    .is-clean:not(.is-body-font) figcaption { font-family: var(--font-heading); font-style: normal; }
    .is-clean .cactus-content { font-size: 1.0625rem; line-height: 1.6; }
    .is-clean .cactus-content blockquote { color: inherit; border-left: 0.2rem solid color-mix(in srgb, var(--color-global-text) 28%, transparent); }
    .is-clean .cactus-content blockquote p { margin: 0.6rem 0; }
    /* Author card after each post. */
    .author-card { margin-top: 3rem; padding: 1.4rem; border-radius: 0.9rem; background: color-mix(in srgb, var(--color-global-text) 6%, transparent); font-family: var(--font-heading); font-style: normal; }
    /* Photo beside the name, label and location; bio and icons run the full width below. */
    .author-card__head { display: flex; gap: 1rem; align-items: center; }
    .author-card__avatar { flex: 0 0 auto; }
    .author-card__avatar img { display: block; width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; }
    .author-card p { margin: 0; }
    .author-card__eyebrow { color: color-mix(in srgb, var(--color-global-text) 55%, transparent); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .author-card__name { margin-top: 0.15rem !important; font-weight: 600; font-size: 1.2rem; line-height: 1.3; }
    .author-card__name a { color: var(--color-global-text); text-decoration: none; }
    .author-card__name a:hover { text-decoration: underline; }
    .author-card__location { display: flex; align-items: center; gap: 0.3rem; margin-top: 0.2rem !important; color: color-mix(in srgb, var(--color-global-text) 60%, transparent); font-size: 0.85rem; }
    .author-card__bio { margin-top: 1rem !important; color: color-mix(in srgb, var(--color-global-text) 82%, transparent); line-height: 1.5; }
    .author-card__social { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.85rem; }
    .author-card__icon { display: inline-flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; color: var(--color-global-text); background: color-mix(in srgb, var(--color-global-text) 9%, transparent); text-decoration: none; transition: background 0.15s, color 0.15s; }
    .author-card__icon:hover { color: var(--color-global-bg); background: var(--color-link); }
    .author-card__icon-text { font-size: 0.65rem; }
</style>
