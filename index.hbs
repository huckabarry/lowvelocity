{{!< default}}

{{!-- Ghost → Settings → Design → Brand → Publication cover. Shown only when one is uploaded. --}}
{{#if @site.cover_image}}
<figure class="home-cover">
    <img
        srcset="{{img_url @site.cover_image size="m"}} 750w,
                {{img_url @site.cover_image size="l"}} 1140w,
                {{img_url @site.cover_image size="xl"}} 1920w"
        sizes="(min-width: 760px) 700px, 100vw"
        src="{{img_url @site.cover_image size="l"}}"
        alt="{{@site.title}}"
    >
</figure>
<style>
    .home-cover { margin: 0 0 2.5rem; }
    .home-cover img { display: block; width: 100%; height: auto; max-height: 26rem; object-fit: cover; border-radius: 4px; }
</style>
{{/if}}

{{!-- Homepage sections: Ghost → Settings → Design → Theme → Homepage → "Homepage sections".
     Sections appear in the order typed there. Each one lives in partials/home/. --}}

{{#split @custom.homepage_sections separator="," as |sections|}}
    {{#foreach sections as |section|}}
        {{#match section "~" "pinned"}}{{> "home/pinned"}}{{/match}}
        {{#match section "~" "photos"}}{{> "home/photos"}}{{/match}}
        {{#match section "~" "urbanism"}}{{> "home/urbanism"}}{{/match}}
        {{#match section "~" "posts"}}{{> "home/posts"}}{{/match}}
        {{#match section "~" "bluesky"}}{{> "home/bluesky"}}{{/match}}
    {{/foreach}}
{{/split}}

<style>
    .home-section { margin-bottom: 3rem; }
    .home-section .section-description { margin: 0 0 2rem; }
    .cactus-title a { text-decoration: none; }
    .cactus-title a:hover { text-decoration: underline; }
    .archive-header { margin-bottom: 2rem; }
    .archive-header + .archive-section { margin-top: 0; }
    /* Latest Photos: a sideways-scrolling strip, like a Bluesky post with many images.
       Photos keep their own shape at a fixed height and snap into place. */
    .home-photos { display: flex; gap: 0.5rem; margin: 0; padding: 0 0 0.5rem; list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; }
    .home-photos li { flex: 0 0 auto; scroll-snap-align: start; }
    .home-photos a { display: block; overflow: hidden; border-radius: 0.65rem; background: color-mix(in srgb, var(--color-global-text) 6%, transparent); }
    .home-photos img { display: block; height: 16rem; width: auto; min-width: 8rem; max-width: min(85vw, 30rem); object-fit: cover; transition: opacity 0.2s; }
    .home-photos a:hover img { opacity: 0.85; }
    /* Phones: run the strip to the screen edges, with the first photo lined up with the text.
       Below 640px the theme's page gutter is 1.25rem (.cactus-shell in screen.css). */
    @media (max-width: 639px) {
        .home-photos { margin-inline: -1.25rem; padding-inline: 1.25rem; scroll-padding-inline: 1.25rem; }
    }
    @media (min-width: 640px) { .home-photos img { height: 20rem; } }
</style>
