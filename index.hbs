{{!< default}}

{{!-- Ghost → Settings → Design → Brand → Publication cover. Shown only when one is uploaded. --}}
{{#if @site.cover_image}}
<figure class="home-cover">
    <img
        srcset="{{img_url @site.cover_image size="m"}} 750w,
                {{img_url @site.cover_image size="l"}} 1140w,
                {{img_url @site.cover_image size="xl"}} 1920w"
        sizes="(min-width: 760px) 700px, 100vw"
        src="{{img_url @site.cover_image size="l"}}"
        alt="{{@site.title}}"
    >
</figure>
<style>
    .home-cover { margin: 0 0 2.5rem; }
    .home-cover img { display: block; width: 100%; height: auto; max-height: 26rem; object-fit: cover; border-radius: 4px; }
</style>
{{/if}}

{{!-- Homepage sections: Ghost → Settings → Design → Theme → Homepage → "Homepage sections".
     Each word turns a section on; the order on the page is fixed. --}}

{{#match @custom.homepage_sections "~" "pinned"}}
{{#get "posts" filter="featured:true" limit="3" include="tags" as |pinned_posts|}}
    {{#if pinned_posts}}
    <section class="cactus-section home-section">
        <h2 class="cactus-title cactus-title-small">{{t "Pinned"}}</h2>
        <ul class="post-list" role="list">
            {{#foreach pinned_posts}}
                {{> "post-preview"}}
            {{/foreach}}
        </ul>
    </section>
    {{/if}}
{{/get}}
{{/match}}

{{#match @custom.homepage_sections "~" "photos"}}
{{#get "posts" filter="tag:[gallery,photography]+tag:-hash-bluesky+feature_image:-null" limit="6" as |photo_posts|}}
    {{#if photo_posts}}
    <section class="cactus-section home-section">
        <h2 class="cactus-title cactus-title-link"><a href="{{@site.url}}/gallery/">{{t "Latest photos"}}</a></h2>
        <ul class="home-photos" role="list">
            {{#foreach photo_posts}}
            <li>
                <a href="{{url}}" aria-label="{{title}}">
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 750w"
                        sizes="(min-width: 760px) 230px, 33vw"
                        src="{{img_url feature_image size="s"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        loading="lazy"
                    >
                </a>
            </li>
            {{/foreach}}
        </ul>
    </section>
    {{/if}}
{{/get}}
{{/match}}

{{#match @custom.homepage_sections "~" "urbanism"}}
{{#get "posts" filter="tag:[urbanism,housing,transportation,public-finance]" limit="5" include="tags" as |urbanism_posts|}}
    {{#if urbanism_posts}}
    <section class="cactus-section home-section">
        <h2 class="cactus-title cactus-title-link"><a href="{{@site.url}}/urbanism/">{{t "Urbanism"}}</a></h2>
        <ul class="post-list" role="list">
            {{#foreach urbanism_posts}}
                {{> "post-preview"}}
            {{/foreach}}
        </ul>
    </section>
    {{/if}}
{{/get}}
{{/match}}

{{#match @custom.homepage_sections "~" "posts"}}
<header class="archive-header">
    <h1 class="cactus-title">Field Notes</h1>
    <p>Travel, photography, urbanism, and notes from being out in the world.</p>
</header>

<section class="cactus-section archive-section">
    <ul class="post-list" role="list">
        {{#get "posts" filter="tag:[field-notes,urbanism,housing,transportation,public-finance]" limit="100" include="tags" order="published_at desc" as |field_notes|}}
            {{#foreach field_notes}}
                {{> "post-preview"}}
            {{else}}
                <li>No field notes are published yet.</li>
            {{/foreach}}
        {{/get}}
    </ul>
</section>
{{/match}}

{{#match @custom.homepage_sections "~" "bluesky"}}
{{#if @custom.bluesky_handle}}
<section class="home-profile-card" aria-label="Follow {{@site.title}} on Bluesky">
    <a class="home-profile-card__identity" href="https://bsky.app/profile/{{@custom.bluesky_handle}}" target="_blank" rel="me noopener noreferrer">
        {{#if @site.icon}}
        <img class="home-profile-card__avatar" src="{{img_url @site.icon absolute="true"}}" alt="" loading="lazy" data-avatar-fallback="LV">
        {{/if}}
        <span class="home-profile-card__text">
            <strong>{{@site.title}}</strong>
            <span>@{{@custom.bluesky_handle}} on Bluesky</span>
        </span>
    </a>
</section>
{{/if}}
{{/match}}

<style>
    .home-section { margin-bottom: 3rem; }
    .home-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
    .home-photos a { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 4px; }
    .home-photos img { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.2s; }
    .home-photos a:hover img { opacity: 0.85; }
</style>
